{
  "expo": {
    "name": "Outfit AI",
    "slug": "outfitai-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "outfitai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ayush.outfitai",
      "infoPlist": {
        "NSCameraUsageDescription": "Outfit AI needs camera access to photograph your clothing items.",
        "NSPhotoLibraryUsageDescription": "Outfit AI needs photo library access to add items from your gallery.",
        "NSLocationWhenInUseUsageDescription": "Outfit AI uses your location to suggest weather-appropriate outfits."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F9F9F9"
      },
      "package": "com.yourname.outfitai",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Outfit AI needs photo access to add wardrobe items."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Outfit AI needs camera access to photograph clothing items."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F9F9F9"
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "974dab54-0352-4bf3-a682-d0a786ca4376"
      }
    }
  }
}
